{
  "manifest_version": 3,
  "name": "TurboFetch",
  "version": "2.1.0",
  "description": "TurboFetch video downloader for video, audio and subtitles across 1800+ sites.",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "downloads",
    "notifications",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TurboFetch",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
